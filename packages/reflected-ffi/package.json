    },
    "./array": {
      "types": "./dist/direct/array.d.ts",
      "import": "./dist/array.js"
    },
    "./buffer": {
      "types": "./dist/direct/buffer.d.ts",
      "import": "./dist/buffer.js"
    },
    "./decoder": {
      "types": "./dist/direct/decoder.d.ts",
      "import": "./dist/decoder.js"
    },
    "./encoder": {
      "types": "./dist/direct/encoder.d.ts",
      "import": "./dist/encoder.js"
    },
    "./direct": {
      "types": "./dist/direct/index.d.ts",
      "import": "./dist/direct/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    }
