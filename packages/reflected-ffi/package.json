      "import": "./dist/traps.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/symbol": {
      "types": "./dist/utils/symbol.d.ts",
      "import": "./dist/utils/symbol.js"
    },
    "./utils/global": {
      "types": "./dist/utils/global.d.ts",
      "import": "./dist/utils/global.js"
    },
    "./query": {
      "types": "./dist/utils/query.d.ts",
      "import": "./dist/query.js"
    },
    "./gather": {
      "types": "./dist/utils/gather.d.ts",
      "import": "./dist/gather.js"
    },
    "./to-json-callback": {
      "types": "./dist/utils/to-json-callback.d.ts",
      "import": "./dist/to-json-callback.js"
    },
    "./utils/heap": {
      "types": "./dist/utils/heap.d.ts",
      "import": "./dist/utils/heap.js"
    },
    "./utils/events": {
      "types": "./dist/utils/events.d.ts",
