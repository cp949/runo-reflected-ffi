{
  "name": "@cp949/runo-reflected-ffi",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/runo-reflected-ffi.git",
    "directory": "packages/reflected-ffi"
  },
  "homepage": "https://github.com/cp949/runo-reflected-ffi/tree/main/packages/reflected-ffi#readme",
