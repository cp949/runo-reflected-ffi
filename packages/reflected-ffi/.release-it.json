{
  "git": {
    "commitMessage": "release: v${version}",
    "tagName": "v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "npm": {
    "publish": true
  },
  "hooks": {
    "before:init": ["pnpm test", "pnpm check-types", "pnpm lint", "pnpm build"]
  }
}
