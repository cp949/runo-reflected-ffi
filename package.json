{
  "name": "runo-reflected-ffi",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "demo": "pnpm --filter demo dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "release": "pnpm --filter @cp949/runo-reflected-ffi release"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "^2.11.2",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
